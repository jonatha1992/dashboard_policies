# Database Configuration
# Opción 1: URL completa (preferida)
DB_URL=postgresql://user:password@host:5432/dbname
# Opción 2: Variables individuales (alternativa)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=challenge_teknet
# DB_USER=postgres
# DB_PASSWORD=postgres

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini Configuration (optional - for AI insights)
# Esquema numerado unificado en todos los repos. El colector canonico
# (src/config/apiKeys.ts) lee GEMINI_API_KEY1..20, acepta lista en una linea
# (GEMINI_API_KEYS=k1,k2,k3) y deduplica por valor. AIInsightsService rota entre
# ellas ante 429/401/503 antes de caer al analisis local.
#
# La cuota de Gemini es por proyecto de Google Cloud, asi que sumar keys
# multiplica cuota solo si salen de proyectos distintos.
GEMINI_API_KEY1=
GEMINI_API_KEY2=

# Logging
LOG_LEVEL=info

# Security
# URL(s) permitidas separadas por comas (ej: http://localhost:5173 o https://tu-app.vercel.app)
# Origen permitido para CORS (puedes poner varios separados por coma)
# Ejemplo: http://localhost:5173,https://tu-app.railway.app
CORS_ORIGIN=http://localhost:5173
# Key secreta para proteger la API (debe enviarse en el header x-api-key)
API_KEY=challenge_tekne_secret_key_2024
